# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---------------------------------------------------------------------- ai
# Required for summarisation, analysis, Ask AI and translation.
# Issued at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ------------------------------------------------------------- environment
# development | test | production
DOCINTEL_ENVIRONMENT=development

# ---------------------------------------------------------------- security
# required — every request needs a bearer token (the default, and the only
#            value permitted in production)
# open     — DEVELOPMENT ONLY. Unauthenticated requests act as a built-in dev
#            user so the app can be demonstrated without signing in.
#            Authorization still applies: tenant isolation is unaffected.
#            The server refuses to start with this in production.
DOCINTEL_AUTH_MODE=required

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DOCINTEL_SECRET_KEY=

# ---------------------------------------------------------------- database
# SQLite by default so a clone runs with no setup. For production:
#   postgresql+psycopg://user:password@host:5432/docintel
# No Postgres driver ships in requirements.txt -- pip install "psycopg[binary]"
# before pointing this at Postgres.
# DOCINTEL_DATABASE_URL=

# ----------------------------------------------------------------- storage
# local | s3   -- only 'local' is implemented. Setting 's3' raises at startup.
#                 The S3 settings below are read but unused until it is.
# DOCINTEL_STORAGE_DRIVER=local
# DOCINTEL_S3_BUCKET=
# DOCINTEL_S3_REGION=

# ------------------------------------------------------------------- limits
# DOCINTEL_MAX_UPLOAD_MB=200
# DOCINTEL_AI_WORKERS=4
